# Optional. If these are unset, the portal signs in as admin / Pa55w0rd12#.
PORTAL_USERNAME=admin
PORTAL_PASSWORD=Pa55w0rd12#

# Set a long random string on Vercel so session cookies cannot be forged.
SESSION_SECRET=

# Added automatically when a Vercel Blob store is connected to the project.
# Current stores set BLOB_STORE_ID. Vercel also provides VERCEL_OIDC_TOKEN at runtime.
# Older stores set BLOB_READ_WRITE_TOKEN instead.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
